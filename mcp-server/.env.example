PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

KUBECONFIG_PATH=
DEFAULT_NAMESPACE=default

# Keep false in production; the MCP server is read-only by default per
# the platform's security posture (see README.md "Security").
ALLOW_MUTATIONS=false

REQUEST_TIMEOUT_SECONDS=15

TRANSPORT=stdio
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

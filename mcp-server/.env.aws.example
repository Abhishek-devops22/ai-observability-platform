# Template for running the MCP server OUTSIDE the cluster (e.g. on your
# laptop) but pointed at a real AWS-deployed observability stack — e.g.
# via `kubectl port-forward`, or an internal load balancer you can reach.
#
# For running the server INSIDE the cluster (the normal AWS path), you
# don't need this file at all: kubernetes/mcp-server/configmap.yaml
# supplies the same variables as real env vars, which pydantic-settings
# (config.py) reads exactly the same way it reads a .env file. Deploy
# with: kubectl apply -f kubernetes/mcp-server/ (see that directory's
# manifests, and mcp-server/README.md "Running in-cluster").
#
# cp .env.aws.example .env, then fill in real values, e.g.:
#   kubectl port-forward -n observability svc/prometheus-kube-prometheus-prometheus 9090:9090
#   kubectl port-forward -n observability svc/loki-gateway 3100:80
#   kubectl port-forward -n observability svc/tempo 3200:3200

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# Point at the kubeconfig terraform wrote (see infrastructure/terraform
# output "configure_kubectl"), or leave empty to use your default
# kubeconfig / current context.
KUBECONFIG_PATH=
DEFAULT_NAMESPACE=default

ALLOW_MUTATIONS=false

REQUEST_TIMEOUT_SECONDS=15

TRANSPORT=stdio
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
